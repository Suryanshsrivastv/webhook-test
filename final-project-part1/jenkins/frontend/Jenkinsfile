pipeline {
    agent any

    environment {
        AWS_REGION   = 'ap-south-1'
        S3_BUCKET    = 'my-frontend-bucket-20260924045231568500000002'
    }

    stages {
        stage('checkout') {
            steps {
                git branch: 'master', credentialsId: 'github-creds', url: 'https://github.com/Suryanshsrivastv/TaskManager_app'
            }
        }

        stage('sync to s3') {
            steps {
                dir('frontend') {
                    sh "aws s3 sync . s3://${S3_BUCKET} --delete --region ${AWS_REGION}"
                }
            }
        }
    }

    post {
        success {
            echo 'frontend deployed to s3'
        }
        failure {
            echo 'frontend pipeline failed'
        }
    }
}